{
  "name": "karolyne-beauty",
  "productName": "Karolyne Paola Beauty",
  "description": "Sistema de gestão para massoterapia e estética",
  "author": "Karolyne Paola Beauty",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win --dir",
    "schema": "node scripts/gen-supabase-schema.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "node-sqlite3-wasm": "^0.8.60",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "br.com.karolynepaolabeauty.gestao",
    "productName": "Karolyne Paola Beauty",
    "copyright": "Karolyne Paola Beauty",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "artifactName": "Karolyne-Paola-Beauty-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Karolyne Paola Beauty",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "language": "1046"
    },
    "asarUnpack": [
      "**/node_modules/node-sqlite3-wasm/**"
    ]
  }
}
